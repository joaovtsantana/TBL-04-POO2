
using System;
using NLog;
using NLog.Config;
using NLog.Targets;

class Conta
{
    public decimal Saldo { get; private set; }

    private static readonly Logger logger =
        LogManager.GetLogger("Conta");

    public Conta(decimal saldo)
    {
        Saldo = saldo;
    }

    public void Sacar(decimal valor)
    {
        logger.Info("Tentativa de saque de {0}", valor);

        if (valor <= 0)
        {
            logger.Warn("Tentativa de saque com valor inválido");
            throw new ArgumentException("Valor inválido");
        }

        if (Saldo < valor)
        {
            logger.Error("Erro: saldo insuficiente");
            throw new Exception("Saldo insuficiente");
        }

        Saldo -= valor;

        logger.Info("Saque realizado com sucesso");
    }
}

class Program
{
    private static readonly Logger logger =
        LogManager.GetCurrentClassLogger();

    static void Main(string[] args)
    {
        var config = new LoggingConfiguration();

        var arquivo = new FileTarget("arquivo")
        {
            FileName = "log.txt",
            Layout = "${longdate} | ${level} | ${message} ${exception}"
        };

        var console = new ConsoleTarget("console")
        {
            Layout = "${longdate} | ${level} | ${message} ${exception}"
        };

        config.AddRule(LogLevel.Info, LogLevel.Fatal, arquivo);
        config.AddRule(LogLevel.Info, LogLevel.Fatal, console);

        LogManager.Configuration = config;

        try
        {
            Conta conta = new Conta(500);

            try
            {
                conta.Sacar(700);
            }
            catch (Exception ex)
            {
                logger.Error(ex, "Não foi possível realizar o saque");
            }

            Console.WriteLine("Saldo atual: " + conta.Saldo);
        }
        finally
        {
            LogManager.Shutdown();
        }
    }
}
