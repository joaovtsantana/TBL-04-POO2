
using System;
using NLog;
using NLog.Config;
using NLog.Targets;

class Conta
{
    public int Numero { get; private set; }
    public decimal Saldo { get; private set; }

    private static readonly Logger logger =
        LogManager.GetLogger("Conta");

    public Conta(int numero, decimal saldo)
    {
        Numero = numero;
        Saldo = saldo;
    }

    public void Depositar(decimal valor)
    {
        logger.Info("Início do depósito");

        if (valor <= 0)
            throw new ArgumentException("Valor inválido");

        Saldo += valor;

        logger.Info("Depósito realizado com sucesso: {0}", valor);
    }

    public void Sacar(decimal valor)
    {
        logger.Info("Início do saque");

        if (valor <= 0)
            throw new ArgumentException("Valor inválido");

        if (Saldo < valor)
            throw new Exception("Saldo insuficiente");

        Saldo -= valor;

        logger.Info("Saque realizado com sucesso: {0}", valor);
    }

    public void Transferir(Conta destino, decimal valor)
    {
        logger.Info("Início da transferência");

        try
        {
            Sacar(valor);
            destino.Depositar(valor);

            logger.Info("Transferência realizada com sucesso");
        }
        catch (Exception ex)
        {
            logger.Error(ex, "Erro ao realizar transferência");
            throw;
        }
    }
}

class Program
{
    private static readonly Logger logger =
        LogManager.GetCurrentClassLogger();

    static void Main(string[] args)
    {
        var config = new LoggingConfiguration();

        var arquivo = new FileTarget("arquivo")
        {
            FileName = "log.txt",
            Layout = "${longdate} | ${level} | ${message} ${exception}"
        };

        var console = new ConsoleTarget("console")
        {
            Layout = "${longdate} | ${level} | ${message} ${exception}"
        };

        config.AddRule(LogLevel.Info, LogLevel.Fatal, arquivo);
        config.AddRule(LogLevel.Info, LogLevel.Fatal, console);

        LogManager.Configuration = config;

        Conta conta1 = new Conta(1, 1000);
        Conta conta2 = new Conta(2, 500);

        try
        {
            // Depósito
            try
            {
                conta1.Depositar(300);
            }
            catch (Exception ex)
            {
                logger.Error(ex, "Erro no depósito");
            }

            // Saque
            try
            {
                conta1.Sacar(200);
            }
            catch (Exception ex)
            {
                logger.Error(ex, "Erro no saque");
            }

            // Transferência
            try
            {
                conta1.Transferir(conta2, 150);
            }
            catch (Exception ex)
            {
                logger.Error(ex, "Erro na transferência");
            }

            Console.WriteLine("Saldo da conta 1: " + conta1.Saldo);
            Console.WriteLine("Saldo da conta 2: " + conta2.Saldo);
        }
        finally
        {
            LogManager.Shutdown();
        }
    }
}
